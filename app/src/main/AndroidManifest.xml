<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".features.appearance.ElGhanimahApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.El8animah">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.El8animah"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".features.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/title_activity_settings"
            android:theme="@style/Theme.El8animah"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".features.pinlock.PinSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.El8animah"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".features.pinlock.PinLockActivity"
            android:exported="false"
            android:label="@string/title_activity_pin_lock"
            android:theme="@style/Theme.El8animah"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".features.OurAppsActivity"
            android:exported="false"
            android:label="@string/title_activity_our_apps"
            android:theme="@style/Theme.El8animah"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".features.AboutActivity"
            android:exported="false"
            android:label="@string/title_activity_about"
            android:theme="@style/Theme.El8animah"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".features.appearance.AppearanceActivity"
            android:exported="false"
            android:label="@string/title_activity_appearance"
            android:theme="@style/Theme.El8animah"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>